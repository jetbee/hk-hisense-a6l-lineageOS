     VoLTE (voice only) for the Japanese carriers this device is used with.
     The stock vendor's RTP service is too old for video calls, and Wi-Fi
     calling is not set up, so both stay off.
-->
<carrier_config_list>
    <!-- docomo -->
    <carrier_config mcc="440" mnc="10">
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="carrier_volte_provisioning_required_bool" value="false" />
        <boolean name="carrier_vt_available_bool" value="false" />
        <boolean name="carrier_wfc_ims_available_bool" value="false" />
    </carrier_config>
