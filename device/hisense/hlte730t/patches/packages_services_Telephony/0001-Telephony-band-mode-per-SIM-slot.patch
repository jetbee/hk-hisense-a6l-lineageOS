 import android.os.Binder;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
 import android.os.PersistableBundle;
 import android.os.Process;
 import android.os.RemoteException;
@@ -41,6 +45,8 @@ import java.util.HashMap;
 import java.util.List;
 import java.util.Map;
 import java.util.TreeSet;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
 
 /**
  * Takes actions based on the adb commands given by "adb shell cmd phone ...". Be careful, no
@@ -62,6 +68,7 @@ public class TelephonyShellCommand extends BasicShellCommandHandler {
     private static final String END_BLOCK_SUPPRESSION = "end-block-suppression";
     private static final String CARRIER_CONFIG_SUBCOMMAND = "cc";
     private static final String DATA_TEST_MODE = "data";
+    private static final String BAND_MODE_SUBCOMMAND = "band-mode";
     private static final String DATA_ENABLE = "enable";
     private static final String DATA_DISABLE = "disable";
 
@@ -163,6 +170,8 @@ public class TelephonyShellCommand extends BasicShellCommandHandler {
                 return handleDataTestModeCommand();
             case END_BLOCK_SUPPRESSION:
                 return handleEndBlockSuppressionCommand();
+            case BAND_MODE_SUBCOMMAND:
+                return handleBandModeCommand();
             default: {
                 return handleDefaultCommands(cmd);
             }
@@ -185,11 +194,101 @@ public class TelephonyShellCommand extends BasicShellCommandHandler {
         pw.println("    Data Test Mode Commands.");
         pw.println("  cc");
         pw.println("    Carrier Config Commands.");
+        pw.println("  band-mode");
+        pw.println("    Radio band mode (RIL SET_BAND_MODE) of one SIM slot.");
         onHelpIms();
         onHelpEmergencyNumber();
         onHelpEndBlockSupperssion();
         onHelpDataTestMode();
         onHelpCc();
+        onHelpBandMode();
+    }
+
+    private void onHelpBandMode() {
+        PrintWriter pw = getOutPrintWriter();
+        pw.println("Band Mode Commands:");
+        pw.println("  band-mode SLOT_ID");
+        pw.println("    List the band modes the modem reports as available for SLOT_ID.");
+        pw.println("  band-mode SLOT_ID MODE");
+        pw.println("    Set the band mode of SLOT_ID, as Phone info > Select radio band does");
+        pw.println("    for the default phone only: 0 = automatic, 1 = Europe, 2 = USA,");
+        pw.println("    3 = Japan, 4 = Australia, 5 = Australia 2, 6 = cellular 800, ...");
+        pw.println("    (Phone.BM_*). The modem may keep the setting across reboots.");
+    }
+
+    // Runs a Phone request that answers through a Message and waits for it.
+    private AsyncResult callPhone(java.util.function.Consumer<Message> request) {
+        final CountDownLatch latch = new CountDownLatch(1);
+        final AsyncResult[] result = new AsyncResult[1];
+        Handler handler = new Handler(Looper.getMainLooper()) {
+            @Override
+            public void handleMessage(Message msg) {
+                result[0] = (AsyncResult) msg.obj;
+                latch.countDown();
+            }
+        };
+        request.accept(handler.obtainMessage());
+        try {
+            if (!latch.await(10, TimeUnit.SECONDS)) return null;
+        } catch (InterruptedException e) {
+            return null;
+        }
+        return result[0];
+    }
+
+    private int handleBandModeCommand() {
+        PrintWriter errPw = getErrPrintWriter();
+        if (!checkShellUid()) {
+            errPw.println("band-mode: only adb (shell or root) may use this command.");
+            return -1;
+        }
+        String slotString = getNextArgRequired();
+        String modeString = getNextArg();
+        int slotId;
+        try {
+            slotId = Integer.parseInt(slotString);
+        } catch (NumberFormatException e) {
+            errPw.println("band-mode: " + slotString + " is not a valid SLOT_ID.");
+            return -1;
+        }
+        Phone phone = SubscriptionManager.isValidPhoneId(slotId)
+                ? PhoneFactory.getPhone(slotId) : null;
+        if (phone == null) {
+            errPw.println("band-mode: no phone for slot " + slotId + ".");
+            return -1;
+        }
+        if (modeString == null) {
+            AsyncResult ar = callPhone(phone::queryAvailableBandMode);
+            if (ar == null || ar.exception != null) {
+                errPw.println("band-mode: query failed: "
+                        + (ar == null ? "timeout" : ar.exception));
+                return -1;
+            }
+            int[] modes = (int[]) ar.result;
+            StringBuilder sb = new StringBuilder();
+            // The first element is the number of modes that follow.
+            for (int i = 1; modes != null && i < modes.length; i++) {
+                if (sb.length() > 0) sb.append(' ');
+                sb.append(modes[i]);
+            }
+            getOutPrintWriter().println("slot " + slotId + " available: " + sb);
+            return 0;
+        }
+        int mode;
+        try {
+            mode = Integer.parseInt(modeString);
+        } catch (NumberFormatException e) {
+            errPw.println("band-mode: " + modeString + " is not a valid MODE.");
+            return -1;
+        }
+        AsyncResult ar = callPhone(msg -> phone.setBandMode(mode, msg));
+        if (ar == null || ar.exception != null) {
+            errPw.println("band-mode: set failed: " + (ar == null ? "timeout" : ar.exception));
+            return -1;
+        }
+        Log.i(LOG_TAG, "band-mode: slot " + slotId + " set to " + mode);
+        getOutPrintWriter().println("slot " + slotId + " band mode set to " + mode);
+        return 0;
     }
 
     private void onHelpIms() {
