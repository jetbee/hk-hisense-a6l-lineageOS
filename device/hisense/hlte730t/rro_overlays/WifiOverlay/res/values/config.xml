<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi resources for the A6L (qcacld-3.0), following the official SDM660
     trees. 5 GHz SoftAP stays on W52 (36-48) under the JP country code; it
     also needs gindoor_channel_support=1 in the vendor ini (stage 1 vendor).
     The hotspot still defaults to 2.4 GHz; 5 GHz is used only when chosen
     in Settings. -->
<resources>
    <!-- The chip has 5 GHz; lets the hotspot offer the 5 GHz band. -->
    <bool translatable="false" name="config_wifi5ghzSupport">true</bool>
    <bool translatable="false" name="config_wifi_softap_ieee80211ac_supported">true</bool>
    <!-- Driver ACS picks the SoftAP channel within the list below. -->
    <bool translatable="false" name="config_wifi_softap_acs_supported">true</bool>
    <!-- W52 only (36-48): usable without DFS under the Japanese rules. -->
    <string translatable="false" name="config_wifiSoftap5gChannelList">36-48</string>
</resources>
